<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions_bpmn-collaboration" targetNamespace="https://example.invalid/workflow-diagrams"><bpmn:process id="process_requester" isExecutable="false"><bpmn:startEvent id="r_start" name="Request"><bpmn:outgoing>r1</bpmn:outgoing></bpmn:startEvent><bpmn:sendTask id="send_request" name="Send request"><bpmn:incoming>r1</bpmn:incoming><bpmn:outgoing>r2</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="receive_result" name="Receive outcome"><bpmn:incoming>r2</bpmn:incoming><bpmn:outgoing>r3</bpmn:outgoing></bpmn:receiveTask><bpmn:endEvent id="r_end" name="Done"><bpmn:incoming>r3</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="r1" name="" sourceRef="r_start" targetRef="send_request" /><bpmn:sequenceFlow id="r2" name="Wait for outcome" sourceRef="send_request" targetRef="receive_result" /><bpmn:sequenceFlow id="r3" name="" sourceRef="receive_result" targetRef="r_end" /></bpmn:process><bpmn:process id="process_processor" isExecutable="false"><bpmn:startEvent id="p_start" name="Start"><bpmn:outgoing>p1</bpmn:outgoing></bpmn:startEvent><bpmn:receiveTask id="receive_request" name="Receive request"><bpmn:incoming>p1</bpmn:incoming><bpmn:outgoing>p2</bpmn:outgoing></bpmn:receiveTask><bpmn:task id="review" name="Review request"><bpmn:incoming>p2</bpmn:incoming><bpmn:incoming>rework</bpmn:incoming><bpmn:outgoing>p3</bpmn:outgoing></bpmn:task><bpmn:boundaryEvent id="timer" name="24h" attachedToRef="review" cancelActivity="true"><bpmn:outgoing>timeout</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration>PT24H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:exclusiveGateway id="decision" name="Decision" default="reject"><bpmn:incoming>p3</bpmn:incoming><bpmn:outgoing>approve</bpmn:outgoing><bpmn:outgoing>rework</bpmn:outgoing><bpmn:outgoing>reject</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="send_approved" name="Send approved"><bpmn:incoming>approve</bpmn:incoming><bpmn:outgoing>p4</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="send_rejected" name="Send rejected"><bpmn:incoming>reject</bpmn:incoming><bpmn:incoming>timeout</bpmn:incoming><bpmn:outgoing>p5</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="p_end" name="Complete"><bpmn:incoming>p4</bpmn:incoming><bpmn:incoming>p5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="p1" name="" sourceRef="p_start" targetRef="receive_request" /><bpmn:sequenceFlow id="p2" name="" sourceRef="receive_request" targetRef="review" /><bpmn:sequenceFlow id="p3" name="" sourceRef="review" targetRef="decision" /><bpmn:sequenceFlow id="approve" name="approved" sourceRef="decision" targetRef="send_approved"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="rework" name="rework" sourceRef="decision" targetRef="review"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">needsRework == true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="reject" name="otherwise" sourceRef="decision" targetRef="send_rejected" /><bpmn:sequenceFlow id="timeout" name="interrupt after 24h" sourceRef="timer" targetRef="send_rejected" /><bpmn:sequenceFlow id="p4" name="" sourceRef="send_approved" targetRef="p_end" /><bpmn:sequenceFlow id="p5" name="" sourceRef="send_rejected" targetRef="p_end" /></bpmn:process><bpmn:collaboration id="collaboration_bpmn-collaboration"><bpmn:participant id="requester" name="Requester participant" processRef="process_requester" /><bpmn:participant id="processor" name="Processor participant" processRef="process_processor" /><bpmn:messageFlow id="request_message" name="request" sourceRef="send_request" targetRef="receive_request" /><bpmn:messageFlow id="approved_message" name="approved outcome" sourceRef="send_approved" targetRef="receive_result" /><bpmn:messageFlow id="rejected_message" name="rejected outcome" sourceRef="send_rejected" targetRef="receive_result" /></bpmn:collaboration><bpmndi:BPMNDiagram id="diagram_bpmn-collaboration"><bpmndi:BPMNPlane id="plane_bpmn-collaboration" bpmnElement="collaboration_bpmn-collaboration"><bpmndi:BPMNShape id="shape_requester" bpmnElement="requester" isHorizontal="true"><dc:Bounds x="35" y="90" width="1240" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_processor" bpmnElement="processor" isHorizontal="true"><dc:Bounds x="35" y="345" width="1240" height="420" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_r_start" bpmnElement="r_start" isHorizontal="true"><dc:Bounds x="65" y="150" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_send_request" bpmnElement="send_request" isHorizontal="true"><dc:Bounds x="145" y="140" width="150" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_receive_result" bpmnElement="receive_result" isHorizontal="true"><dc:Bounds x="760" y="140" width="170" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_r_end" bpmnElement="r_end" isHorizontal="true"><dc:Bounds x="1140" y="150" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_p_start" bpmnElement="p_start" isHorizontal="true"><dc:Bounds x="65" y="420" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_receive_request" bpmnElement="receive_request" isHorizontal="true"><dc:Bounds x="145" y="405" width="155" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_review" bpmnElement="review" isHorizontal="true"><dc:Bounds x="380" y="405" width="160" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_timer" bpmnElement="timer" isHorizontal="true"><dc:Bounds x="510" y="450" width="32" height="32" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_decision" bpmnElement="decision" isHorizontal="true"><dc:Bounds x="635" y="410" width="48" height="48" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_send_approved" bpmnElement="send_approved" isHorizontal="true"><dc:Bounds x="805" y="405" width="170" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_send_rejected" bpmnElement="send_rejected" isHorizontal="true"><dc:Bounds x="805" y="615" width="170" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_p_end" bpmnElement="p_end" isHorizontal="true"><dc:Bounds x="1140" y="420" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="di_r1" bpmnElement="r1"><di:waypoint x="101" y="168.0" /><di:waypoint x="145" y="170.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_r2" bpmnElement="r2"><di:waypoint x="295" y="170.0" /><di:waypoint x="760" y="170.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_r3" bpmnElement="r3"><di:waypoint x="930" y="170.0" /><di:waypoint x="1140" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_p1" bpmnElement="p1"><di:waypoint x="101" y="438.0" /><di:waypoint x="145" y="435.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_p2" bpmnElement="p2"><di:waypoint x="300" y="435.0" /><di:waypoint x="380" y="435.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_p3" bpmnElement="p3"><di:waypoint x="540" y="435.0" /><di:waypoint x="635" y="434.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_approve" bpmnElement="approve"><di:waypoint x="683" y="434.0" /><di:waypoint x="805" y="435.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_rework" bpmnElement="rework"><di:waypoint x="659" y="410" /><di:waypoint x="659" y="375" /><di:waypoint x="460" y="375" /><di:waypoint x="460" y="405" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_reject" bpmnElement="reject"><di:waypoint x="659.0" y="458" /><di:waypoint x="890.0" y="615" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_timeout" bpmnElement="timeout"><di:waypoint x="526" y="482" /><di:waypoint x="526" y="645" /><di:waypoint x="805" y="645" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_p4" bpmnElement="p4"><di:waypoint x="975" y="435.0" /><di:waypoint x="1140" y="438.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_p5" bpmnElement="p5"><di:waypoint x="975" y="645" /><di:waypoint x="1158" y="645" /><di:waypoint x="1158" y="456" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_request_message" bpmnElement="request_message"><di:waypoint x="220" y="200" /><di:waypoint x="220" y="405" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_approved_message" bpmnElement="approved_message"><di:waypoint x="890" y="405" /><di:waypoint x="890" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="di_rejected_message" bpmnElement="rejected_message"><di:waypoint x="890" y="615" /><di:waypoint x="890" y="560" /><di:waypoint x="1040" y="560" /><di:waypoint x="1040" y="250" /><di:waypoint x="845" y="250" /><di:waypoint x="845" y="200" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
